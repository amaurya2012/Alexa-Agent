# Copy to .env and edit. Never commit .env. Never put real credentials in this file.

# ---- Mode ---------------------------------------------------------------
# true  = demo mode: a rule-based MOCK model replaces Bedrock (no AWS needed, no cost).
#         Tools still run for real against the MCP server + SQLite.
# false = real Amazon Bedrock Converse calls (needs AWS access, see below).
MOCK_MODE=true
APP_ENV=development
LOG_LEVEL=INFO

# ---- Amazon Bedrock (only used when MOCK_MODE=false) ---------------------
# Credentials come from the standard AWS chain (env vars, AWS_PROFILE/SSO, IAM role).
# Do NOT add keys here. Example for a profile:  AWS_PROFILE=my-sso-profile
AWS_REGION=us-east-1
AWS_PROFILE=
# Any Bedrock model / inference-profile ID that supports Converse tool use and that you have
# enabled in your account. Model IDs change over time: copy the exact current ID from the Bedrock
# console, or run:  aws bedrock list-inference-profiles --region <your-region>
# (format example only: us.anthropic.claude-sonnet-4-5-20250929-v1:0)
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
BEDROCK_MAX_RETRIES=2

# ---- MCP server (separate process) --------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# Shared secret between FastAPI and the MCP server. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required if MCP_HOST is not a loopback address.
MCP_AUTH_TOKEN=

# ---- Agent limits ---------------------------------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=15
MAX_MESSAGE_CHARS=2000
CONFIRMATION_TTL_SECONDS=300

# ---- Storage / API ----------------------------------------------------------
# Relative paths are resolved against the backend/ folder.
DATABASE_PATH=data/alexa_agent.db
# Comma-separated list of allowed browser origins (Vite default + CRA default).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional. If set, every /api/* request must send header  X-API-Key: <value>
API_KEY=
